{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block head %}
    {{ parent() }}

    <style>
        .rate-limiter-title { align-items: baseline; display: flex; gap: .75em; }
        .rate-limiter-title small { color: var(--color-muted); font-size: var(--font-size-body); font-weight: normal; }
        .metric .value.rate-limiter-warning { color: var(--color-warning); }
        .metric .value.rate-limiter-error { color: var(--color-error); }

        .rate-limiter-tabs { position: relative; }
        .rate-limiter-filter { position: absolute; right: 0; top: 6px; }

        .rate-limiter-table { table-layout: fixed; }
        .rate-limiter-table th { white-space: nowrap; }
        .rate-limiter-table td { font-family: var(--font-family-system); overflow-wrap: anywhere; vertical-align: middle; }
        .rate-limiter-table code, .rate-limiter-mono { font-family: var(--font-family-monospace); font-size: 13px; }
        .rate-limiter-table .col-id { width: 5em; }
        .rate-limiter-table .col-call { width: 13%; }
        .rate-limiter-table .col-result { width: 13%; }
        .rate-limiter-table .col-tokens { width: 14%; }
        .rate-limiter-table .col-when { width: 11%; }
        .rate-limiter-table .col-time { width: 7%; }
        .rate-limiter-table .text-right { text-align: right; }

        .rate-limiter-key { color: var(--color-muted); display: block; font-size: 12px; }
        .rate-limiter-problem td { background: var(--status-warning-background, rgba(255, 196, 0, .08)); }
        .rate-limiter-failed td { background: var(--status-error-background, rgba(176, 65, 62, .08)); }
        .rate-limiter-sub td { background: var(--table-row-even-background, transparent); }

        .rate-limiter-quiet { align-items: center; color: var(--color-muted); display: inline-flex; gap: 6px; white-space: nowrap; }
        .rate-limiter-quiet::before { background: var(--color-muted); border-radius: 50%; content: ''; height: 7px; width: 7px; }
        .rate-limiter-quiet.dot-success::before { background: var(--color-success); }
        .rate-limiter-quiet.dot-info::before { background: var(--color-link); }
        .rate-limiter-table .label { white-space: nowrap; }

        .rate-limiter-tokens { align-items: center; display: inline-flex; gap: 8px; white-space: nowrap; }
        .rate-limiter-tokens.is-problem { color: var(--color-error); font-weight: bold; }
        .rate-limiter-bar { background: var(--base-2); border-radius: 2px; height: 4px; overflow: hidden; width: 48px; }
        .rate-limiter-bar span { display: block; height: 100%; }
        .rate-limiter-bar .bar-ok { background: var(--color-success); }
        .rate-limiter-bar .bar-low { background: var(--color-warning); }
        .rate-limiter-bar .bar-empty { background: var(--color-error); }

        .rate-limiter-toggle { background: none; border: 0; border-radius: 4px; color: var(--color-muted); cursor: pointer; height: 22px; padding: 0; vertical-align: middle; width: 22px; }
        .rate-limiter-toggle:hover { background: var(--base-2); }
        .rate-limiter-toggle svg { transition: transform .1s; }
        .rate-limiter-toggle[aria-expanded=true] svg { transform: rotate(90deg); }
        .rate-limiter-details td { padding-left: 6.5em; }
        .rate-limiter-facts { display: flex; flex-wrap: wrap; gap: .25em 2em; }
        .rate-limiter-facts dt { color: var(--color-muted); display: inline; margin-right: .4em; }
        .rate-limiter-facts dd { display: inline; margin: 0; }

        .rate-limiter-section { margin-top: 1.5em; }
        .rate-limiter-section h3 { align-items: baseline; display: flex; flex-wrap: wrap; gap: .25em .75em; margin-bottom: .5em; }
        .rate-limiter-section h3 .rate-limiter-mono { font-size: 15px; font-weight: bold; }
        .rate-limiter-section .rate-limiter-key-row { color: var(--color-muted); font-size: 12px; font-weight: normal; }
        .rate-limiter-section h3 small { color: var(--color-muted); font-size: 13px; font-weight: normal; }
        .rate-limiter-section h3 .rate-limiter-problems { color: var(--color-error); font-size: 13px; margin-left: auto; }
    </style>
{% endblock %}

{% block toolbar %}
    {% if collector.topLevelCount > 0 %}
        {% set problems = collector.rejectedCount + collector.errorCount %}
        {% set status_color = collector.errorCount ? 'red' : collector.rejectedCount ? 'yellow' : '' %}
        {% set icon %}
            {{ source('@WebProfiler/Icon/time.svg') }}
            <span class="sf-toolbar-value">{{ problems ? problems ~ ' / ' ~ collector.topLevelCount : collector.topLevelCount }}</span>
        {% endset %}
        {% set text %}
            <div class="sf-toolbar-info-piece">
                <b>Calls</b>
                <span>{{ collector.topLevelCount }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Rejected</b>
                <span class="sf-toolbar-status {{ collector.rejectedCount ? 'sf-toolbar-status-yellow' }}">{{ collector.rejectedCount }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Failed</b>
                <span class="sf-toolbar-status {{ collector.errorCount ? 'sf-toolbar-status-red' }}">{{ collector.errorCount }}</span>
            </div>
            <div class="sf-toolbar-info-piece">
                <b>Time</b>
                <span>{{ '%.1f'|format(collector.totalDuration * 1000) }} ms</span>
            </div>
        {% endset %}
        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {link: profiler_url, status: status_color}) }}
    {% endif %}
{% endblock %}

{% block menu %}
    <span class="label {{ collector.errorCount ? 'label-status-error' : collector.rejectedCount ? 'label-status-warning' }} {{ collector.topLevelCount == 0 ? 'disabled' }}">
        <span class="icon" aria-hidden="true">{{ source('@WebProfiler/Icon/time.svg') }}</span>
        <strong>Rate Limiter</strong>
        {% if collector.topLevelCount %}
            <span class="count"><span>{{ collector.topLevelCount }}</span></span>
        {% endif %}
    </span>
{% endblock %}

{% macro relative(seconds) %}
    {%- if seconds < 0.05 -%}now
    {%- elseif seconds < 10 -%}{{ seconds|round(1, 'ceil') }} s
    {%- elseif seconds < 60 -%}{{ seconds|round(0, 'ceil') }} s
    {%- elseif seconds < 3600 -%}{{ (seconds / 60)|round(0, 'ceil') }} min
    {%- else -%}{{ (seconds / 3600)|round(1) }} h
    {%- endif -%}
{% endmacro %}

{% macro call(operation) %}
    {%- if operation.operation == 'reset' %}reset(){% else %}{{ operation.operation }}({{ operation.tokens }}){% endif -%}
{% endmacro %}

{% macro result(operation) %}
    {%- if operation.failed -%}
        <span class="label status-error">failed</span>
    {%- elseif operation.rejected -%}
        <span class="label status-warning">rejected</span>
    {%- elseif operation.operation == 'reset' -%}
        <span class="rate-limiter-quiet">reset</span>
    {%- elseif operation.operation == 'consume' and operation.tokens == 0 -%}
        <span class="rate-limiter-quiet">checked</span>
    {%- elseif operation.unlimited -%}
        <span class="rate-limiter-quiet dot-success">unlimited</span>
    {%- elseif operation.operation == 'reserve' -%}
        <span class="rate-limiter-quiet dot-info">reserved</span>
    {%- elseif operation.accepted -%}
        <span class="rate-limiter-quiet dot-success">accepted</span>
    {%- else -%}
        <span class="rate-limiter-quiet">unknown</span>
    {%- endif -%}
{% endmacro %}

{% macro tokens(operation) %}
    {%- if operation.unlimited -%}
        <span class="rate-limiter-tokens rate-limiter-mono">∞</span>
    {%- elseif operation.failed or operation.operation == 'reset' or operation.remaining is null -%}
        <span class="text-muted">—</span>
    {%- else -%}
        {%- set percent = operation.limit ? (operation.remaining / operation.limit * 100)|round : 0 -%}
        <span class="rate-limiter-tokens {{ operation.problem ? 'is-problem' }}">
            <span class="rate-limiter-mono">{{ operation.remaining }}/{{ operation.limit }}</span>
            <span class="rate-limiter-bar" aria-hidden="true"><span class="{{ percent == 0 ? 'bar-empty' : percent <= 34 ? 'bar-low' : 'bar-ok' }}" style="width: {{ percent }}%"></span></span>
        </span>
    {%- endif -%}
{% endmacro %}

{% macro when(operation) %}
    {%- import _self as helper -%}
    {%- if operation.timeToAct is not null -%}
        {{ helper.relative(operation.timeToAct - operation.time) == 'now' ? 'now' : 'in ' ~ helper.relative(operation.timeToAct - operation.time) }}
    {%- elseif operation.rejected and operation.retryAfter is not null -%}
        retry {{ helper.relative(operation.retryAfter - operation.time) }}
    {%- elseif operation.resetAt is not null and not operation.failed -%}
        {{ helper.relative(operation.resetAt - operation.time) }}
    {%- else -%}
        <span class="text-muted">—</span>
    {%- endif -%}
{% endmacro %}

{% macro facts(operation) %}
    {%- set facts = [] -%}
    {%- if operation.rejected and operation.remaining is not null -%}
        {%- set facts = facts|merge([['Reason', 'needed ' ~ operation.tokens ~ ', ' ~ operation.remaining ~ ' left']]) -%}
    {%- endif -%}
    {%- if operation.decidedBy -%}
        {%- set facts = facts|merge([['Decided by', operation.decidedBy]]) -%}
    {%- endif -%}
    {%- if operation.timeToAct is not null -%}
        {%- set facts = facts|merge([['Acts at', operation.timeToAct|round(0, 'floor')|date('H:i:s')]]) -%}
    {%- elseif operation.rejected and operation.retryAfter is not null -%}
        {%- set facts = facts|merge([['Retry at', operation.retryAfter|date('H:i:s')]]) -%}
    {%- elseif operation.resetAt is not null and not operation.failed -%}
        {%- set facts = facts|merge([['Resets at', operation.resetAt|date('H:i:s')]]) -%}
    {%- endif -%}
    {%- if operation.settings -%}
        {%- set facts = facts|merge([['Limit', operation.settings]]) -%}
    {%- endif -%}
    {%- if facts -%}
        <dl class="rate-limiter-facts">
            {%- for fact in facts -%}
                <div><dt>{{ fact[0] }}</dt><dd class="rate-limiter-mono">{{ fact[1] }}</dd></div>
            {%- endfor -%}
        </dl>
    {%- endif -%}
{% endmacro %}

{% macro sub_rows(operation, top, depth) %}
    {%- import _self as helper -%}
    {% for child in operation.children %}
        <tr data-row-of="{{ top }}" data-problem="{{ child.problem ? 1 : 0 }}" class="rate-limiter-sub {{ child.failed ? 'rate-limiter-failed' : child.rejected ? 'rate-limiter-problem' }}">
            <td class="text-muted rate-limiter-mono">{{ child.id }}</td>
            <td style="padding-left: {{ 0.5 + depth * 1.25 }}em"><span class="text-muted" aria-hidden="true">└</span> <strong>{{ child.limiter }}</strong></td>
            <td><code>{{ helper.call(child) }}</code></td>
            <td>{{ helper.result(child) }}</td>
            <td>{{ helper.tokens(child) }}</td>
            <td>{{ helper.when(child) }}</td>
            <td class="text-muted text-right rate-limiter-mono">{{ '%.2f'|format(child.duration * 1000) }}</td>
        </tr>
        {{ helper.sub_rows(child, top, depth + 1) }}
    {% endfor %}
{% endmacro %}

{% block panel %}
    {% import _self as helper %}

    {% set limiters = collector.limiters %}
    <h2 class="rate-limiter-title">Rate Limiter{% if limiters %} <small>{{ limiters|length }} {{ limiters|length == 1 ? 'limiter' : 'limiters' }}</small>{% endif %}</h2>

    {% if collector.operations is empty %}
        <div class="empty empty-panel">
            <p>No rate limiter operations were recorded.</p>
            <p class="text-muted text-small">Limiters created outside the container or used outside of this request are not traced.</p>
        </div>
    {% else %}
        <div class="metrics">
            <div class="metric">
                <span class="value">{{ collector.topLevelCount }}</span>
                <span class="label">Calls</span>
            </div>
            <div class="metric">
                <span class="value {{ collector.rejectedCount ? 'rate-limiter-warning' }}">{{ collector.rejectedCount }}</span>
                <span class="label">Rejected</span>
            </div>
            <div class="metric">
                <span class="value {{ collector.errorCount ? 'rate-limiter-error' }}">{{ collector.errorCount }}</span>
                <span class="label">Failed</span>
            </div>
            <div class="metric">
                <span class="value">{{ '%.1f'|format(collector.totalDuration * 1000) }} <span class="unit">ms</span></span>
                <span class="label">Time</span>
            </div>
        </div>

        <div class="rate-limiter-tabs">
            <label class="rate-limiter-filter"><input type="checkbox" id="rate-limiter-problem-filter"> Problems only</label>

            <div class="sf-tabs" id="rate-limiter-tabs">
                <div class="tab">
                    <h3 class="tab-title">Timeline</h3>
                    <div class="tab-content">
                        <table class="rate-limiter-table" id="rate-limiter-timeline">
                            <thead>
                                <tr>
                                    <th class="col-id">#</th>
                                    <th>Limiter</th>
                                    <th class="col-call">Call</th>
                                    <th class="col-result">Result</th>
                                    <th class="col-tokens">Tokens</th>
                                    <th class="col-when">Resets</th>
                                    <th class="col-time text-right">ms</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for operation in collector.timeline %}
                                    {% set details = helper.facts(operation)|trim %}
                                    {% set expandable = details or operation.children %}
                                    <tr data-top="{{ operation.id }}" data-problem="{{ operation.problem ? 1 : 0 }}" id="rate-limiter-call-{{ operation.id }}" class="{{ operation.failed ? 'rate-limiter-failed' : operation.rejected ? 'rate-limiter-problem' }}">
                                        <td style="white-space: nowrap">
                                            {%- if expandable -%}
                                                <button type="button" class="rate-limiter-toggle" data-toggle="{{ operation.id }}" data-expanded="{{ operation.problem and operation.children ? 1 : 0 }}" aria-expanded="false" aria-label="Show details of call {{ operation.id }}">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
                                                </button>
                                            {%- else -%}
                                                <span style="display: inline-block; width: 22px"></span>
                                            {%- endif %}
                                            <span class="text-muted rate-limiter-mono">{{ operation.id }}</span>
                                        </td>
                                        <td>
                                            <strong>{{ operation.limiter }}</strong>
                                            {% if operation.key is not null %}<span class="rate-limiter-key rate-limiter-mono" title="{{ operation.key }}">{{ operation.key }}</span>{% endif %}
                                        </td>
                                        <td><code>{{ helper.call(operation) }}</code></td>
                                        <td>{{ helper.result(operation) }}</td>
                                        <td>{{ helper.tokens(operation) }}</td>
                                        <td>{{ helper.when(operation) }}</td>
                                        <td class="text-muted text-right rate-limiter-mono">{{ '%.2f'|format(operation.duration * 1000) }}</td>
                                    </tr>
                                    {% if details %}
                                        <tr data-row-of="{{ operation.id }}" class="rate-limiter-details {{ operation.failed ? 'rate-limiter-failed' : operation.rejected ? 'rate-limiter-problem' : 'rate-limiter-sub' }}">
                                            <td colspan="7">{{ details|raw }}</td>
                                        </tr>
                                    {% endif %}
                                    {{ helper.sub_rows(operation, operation.id, 1) }}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab">
                    <h3 class="tab-title">By limiter</h3>
                    <div class="tab-content">
                        {% for limiter in limiters %}
                            {% set policy = limiter.policy is null ? 'custom' : limiter.policy == 'no_limit' ? 'no limit' : limiter.policy|replace({'_': ' '}) %}
                            <div class="rate-limiter-section">
                                <h3>
                                    <span class="rate-limiter-mono">{{ limiter.name }}</span>
                                    <small>
                                        {{- policy -}}
                                        {%- if limiter.settings %} · {{ limiter.settings }}{% elseif limiter.children %} · {{ limiter.children|join(' + ') }}{% endif -%}
                                    </small>
                                    {% if limiter.problems %}<span class="rate-limiter-problems">{{ limiter.problems }} {{ limiter.problems == 1 ? 'problem' : 'problems' }}</span>{% endif %}
                                </h3>

                                <table class="rate-limiter-table">
                                    <thead>
                                        <tr>
                                            <th class="col-id">#</th>
                                            <th>Call</th>
                                            <th class="col-result">Result</th>
                                            <th class="col-tokens">Tokens</th>
                                            <th class="col-time text-right">ms</th>
                                        </tr>
                                    </thead>
                                    {% for key, operations in limiter.keys %}
                                        <tbody>
                                            {% if limiter.keys|length > 1 %}
                                                <tr>
                                                    <th colspan="5" class="rate-limiter-key-row rate-limiter-mono">{{ key is same as('') ? 'no key' : key }}</th>
                                                </tr>
                                            {% endif %}
                                            {% for operation in operations %}
                                                <tr data-problem="{{ operation.problem ? 1 : 0 }}" class="{{ operation.failed ? 'rate-limiter-failed' : operation.rejected ? 'rate-limiter-problem' }}">
                                                    <td class="text-muted rate-limiter-mono">{{ operation.id }}</td>
                                                    <td>
                                                        <code>{{ helper.call(operation) }}</code>
                                                        {% if operation.parent %}<span class="text-muted text-small">via <a href="#rate-limiter-call-{{ operation.parent }}" data-timeline-link="{{ operation.parent }}">#{{ operation.parent }}</a></span>{% endif %}
                                                    </td>
                                                    <td>{{ helper.result(operation) }}</td>
                                                    <td>{{ helper.tokens(operation) }}</td>
                                                    <td class="text-muted text-right rate-limiter-mono">{{ '%.2f'|format(operation.duration * 1000) }}</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    {% endfor %}
                                </table>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script{% if csp_script_nonce is defined and csp_script_nonce %} nonce="{{ csp_script_nonce }}"{% endif %}>
        window.addEventListener('DOMContentLoaded', () => {
            const filter = document.getElementById('rate-limiter-problem-filter');
            if (!filter) {
                return;
            }

            const expanded = new Set();
            const update = () => {
                document.querySelectorAll('#rate-limiter-timeline tr[data-top]').forEach((row) => {
                    const id = row.dataset.top;
                    const visible = !filter.checked || '1' === row.dataset.problem;
                    row.style.display = visible ? '' : 'none';
                    document.querySelectorAll('#rate-limiter-timeline tr[data-row-of="' + id + '"]').forEach((sub) => {
                        sub.style.display = visible && expanded.has(id) ? '' : 'none';
                    });
                    row.querySelector('[data-toggle]')?.setAttribute('aria-expanded', expanded.has(id) ? 'true' : 'false');
                });

                document.querySelectorAll('.rate-limiter-section').forEach((section) => {
                    let visibleRows = 0;
                    section.querySelectorAll('tbody').forEach((group) => {
                        let visibleInGroup = 0;
                        group.querySelectorAll('tr[data-problem]').forEach((row) => {
                            const visible = !filter.checked || '1' === row.dataset.problem;
                            row.style.display = visible ? '' : 'none';
                            visibleInGroup += visible ? 1 : 0;
                        });
                        group.style.display = visibleInGroup ? '' : 'none';
                        visibleRows += visibleInGroup;
                    });
                    section.style.display = visibleRows ? '' : 'none';
                });
            };

            document.querySelectorAll('[data-toggle]').forEach((button) => {
                if ('1' === button.dataset.expanded) {
                    expanded.add(button.dataset.toggle);
                }
                button.addEventListener('click', () => {
                    const id = button.dataset.toggle;
                    expanded.has(id) ? expanded.delete(id) : expanded.add(id);
                    update();
                });
            });

            document.querySelectorAll('[data-timeline-link]').forEach((link) => {
                link.addEventListener('click', () => {
                    document.querySelector('#rate-limiter-tabs > .tab-navigation .tab-control')?.click();
                    expanded.add(link.dataset.timelineLink);
                    update();
                });
            });

            filter.addEventListener('change', update);
            update();
        });
    </script>
{% endblock %}
